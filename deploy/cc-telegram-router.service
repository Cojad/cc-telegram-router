[Unit]
Description=cc-telegram-router (Telegram -> one Claude Code background session per conversation)
After=network-online.target

[Service]
Type=simple
ExecStart=@STATE@/cc-telegram-router
WorkingDirectory=@STATE@
# deploy/install.sh unit: ~/.local/bin, ~/bin, /usr/local/bin, /usr/bin, /bin, with the folders of
# bun (the worker's telegram plugin runs it, plugin/.mcp.json) and claude in front when elsewhere
Environment=PATH=@PATH@
# Workers are started through `claude --bg`, whose daemon would otherwise sit
# in this unit's cgroup and be killed on every router restart.
KillMode=process
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
