{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(/{{folder}}/**)", "Edit(/{{folder}}/**)", "Write(/{{folder}}/**)",
      "Read(/{{home}}/.claude/skills/**)", "Read(/{{botDir}}/.claude/skills/**)", "Read(/{{botDir}}/memory/**)",
      "Bash(ls *)", "Bash(ls)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)",
      "Bash(grep *)", "Bash(rg *)", "Bash(find *)", "Bash(stat *)", "Bash(file *)",
      "Bash(jq *)", "Bash(cut)", "Bash(cut *)", "Bash(sort)", "Bash(sort *)", "Bash(uniq)", "Bash(uniq *)", "Bash(date)", "Bash(date *)", "Bash(echo *)", "Bash(pwd)",
      "Bash(which *)", "Bash(tr *)", "Bash(seq *)", "Bash(hostname)", "Bash(cd)", "Bash(cd *)",
      "Read(/{{transcripts}}/*/tool-results/**)",
      "WebSearch", "WebFetch",
      "mcp__plugin_telegram_telegram"
    ],
    "deny": [
      "Edit(/{{folder}}/.chat/**)", "Write(/{{folder}}/.chat/**)",
      "Bash(find * -exec *)", "Bash(find * -execdir *)", "Bash(find * -delete*)", "Bash(find * -fprint*)",
      "Bash(sort * -o *)", "Bash(sort * --output*)", "Bash(sort -o*)", "Bash(sort --output*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": { "denyRead": ["{{hidden}}", "~"], "allowRead": ["{{folder}}", "{{home}}/.claude/skills", "{{botDir}}/.claude/skills", "{{botDir}}/memory"] }
  }
}
